{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Asistente: construir consultas SQLite",
            "request": "launch",
            "mainClass": "examen.AsistenteConsultas",
            "projectName": "plantilla-sqlite",
            "cwd": "${workspaceFolder}/00-examen",
            "console": "integratedTerminal",
            "vmArgs": "--enable-native-access=ALL-UNNAMED -Dasistente.ancho=64"
        },
        {
            "type": "java",
            "name": "Asistente: generar ejercicio Java",
            "request": "launch",
