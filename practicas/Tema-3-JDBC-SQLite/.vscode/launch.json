            "projectName": "plantilla-sqlite",
            "cwd": "${workspaceFolder}/00-examen",
            "console": "integratedTerminal",
            "vmArgs": "--enable-native-access=ALL-UNNAMED -ea"
        },
        {
            "type": "java",
            "name": "Examen: partir de un SQL",
