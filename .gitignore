# VS Code: solo configuracion compartible conocida
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Java, Maven y Gradle: salidas y caches regenerables
**/target/
**/build/
**/bin/
**/.gradle/
**/.m2/
**/out/
**/.apt_generated/
**/.apt_generated_tests/
*.class
dependency-reduced-pom.xml
.flattened-pom.xml
pom.xml.tag
pom.xml.releaseBackup
release.properties

# JVM
hs_err_pid*
replay_pid*
*.hprof
*.jfr
*.pid

